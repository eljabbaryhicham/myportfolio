/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes security while enabling rapid prototyping. It implements strict
 * authorization controls, focusing on who can access what data, but relaxes schema validation
 * to allow for flexible data shapes during development.  All write operations require
 * authentication. Data structures are flat and avoid complex nested reads for authorization.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information.
 * - /contact/{contactId}: Stores contact page information.
 *
 * Key Security Decisions:
 * - All write operations require authentication (`isSignedIn()`).
 * - No public write operations are allowed.
 * - List operations on /projects are public, but writes are restricted.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, but restricts write access to authenticated users.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read the project.
     * @allow (create): Only authenticated users can create projects, enforcing ownership.
     * @allow (update, delete): Only authenticated users can update or delete projects.
     * @deny  (create, update, delete): If the user is not authenticated.
     * @principle Allows public read access but enforces authentication for all write operations.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    /**
     * @description Grants read and write access to contact information only to authenticated users.
     * @path /contact/{contactId}
     * @allow (get, list): Any authenticated user can read contact information.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete contact information.
     * @deny (create, update, delete): If the user is not authenticated.
     * @principle Restricts access to contact information to authenticated users only.
     */
    match /contact/{contactId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // --- Helper functions ---

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}