/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, enforcing strict access control based on user roles.
 * Read access is generally public unless explicitly restricted. Write access is restricted to authorized users.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project data. Publicly readable.
 * - /contact/{contactId}: Stores contact info. Publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable.
 * - /media/{mediaId}: Stores metadata about uploaded media assets. Restricted to admin users.
 * - /users/{userId}: Stores administrator user data. Owner-only access.
 *
 * Key Security Decisions:
 * - Public read access is granted to the /projects, /contact, and /homepage collections.
 * - Listing of users is disallowed for security reasons.
 * - The /media collection is write-protected and only admins can create, update, or delete documents.
 * - User creation is self-creation, validated by matching the user ID in the path.
 *
 * Denormalization for Authorization:
 *  - The `MediaAsset` entity is missing a clear 'ownerId' or similar field to link it to a specific user.
 *    To properly secure this collection, an 'ownerId' (or similar) would be required.
 *    For example, to allow only specific user to delete it.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to projects. Restricts write access to admins.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, no writes allowed
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to contact info. Restricts write access to admins.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, no writes allowed
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to homepage settings. Restricts write access to admins.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, no writes allowed
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Restricts read and write access to media assets. Only authenticated users can create, update, or delete assets.
     * @path /media/{mediaId}
     * @allow get, list: if isSignedIn();
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @principle Admin-only access to media assets.
     */
    match /media/{mediaId} {
        allow get, list: if isSignedIn();
        allow create: if isAdmin();
        allow update: if isAdmin() && resource != null;
        allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages user data. Allows a user to create their own document, and restricts all other access to the owner.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isSelfCreation(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces strict user-ownership for user profiles.
     */
    match /users/{userId} {
        allow get: if isOwner(userId);
        allow list: if false;
        allow create: if isSelfCreation(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is authenticated, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin based on their role in the user document.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user ID matches the request's authentication UID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is creating their own user document.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user ID matches the request's authentication UID.
     */
    function isSelfCreation(userId) {
      return isSignedIn() && request.auth.uid == userId && request.resource.data.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId - The user ID to compare against the resource's owner ID.
     * @return {boolean} True if the user is the owner and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}