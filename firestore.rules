/**
 * @description This ruleset enforces a role-based access control model for the portfolio application.
 * Only authenticated users with the 'admin' or 'superadmin' role can create, update, or delete data.
 * Read access is generally public, with restrictions for user-specific data.
 * @dataStructure
 * - /projects/{projectId}: Stores project information. Publicly readable.
 * - /contact/{contactId}: Stores contact page information. Publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable.
 * - /media/{mediaId}: Stores media asset metadata. Only admins can create/update/delete.
 * - /users/{userId}: Stores administrator user data, only accessible by the user themselves.
 * @keySecurityDecisions
 * - Public read access for project, contact, and homepage data to allow for easy display on the website.
 * - Strict role-based access control for creating, updating, and deleting media assets and user data.
 * - User documents are only accessible by the user and secured via the `isOwner()` function.
 * - No user listing is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
        return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin');
    }

    /**
     * @description Manages access to project documents.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @allow (create, update, delete): Only admins can modify project data.
     * @deny (create, update, delete): Non-admins cannot modify project data.
     * @principle Public read, admin-only write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages access to contact information documents.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact information.
     * @allow (create, update, delete): Only admins can modify contact information.
     * @deny (create, update, delete): Non-admins cannot modify contact information.
     * @principle Public read, admin-only write.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages access to homepage settings documents.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @allow (create, update, delete): Only admins can modify homepage settings.
     * @deny (create, update, delete): Non-admins cannot modify homepage settings.
     * @principle Public read, admin-only write.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Manages access to media asset documents.
     * @path /media/{mediaId}
     * @allow (get, list): Any user can read media asset metadata.
     * @allow (create, update, delete): Only admins can modify media asset metadata.
     * @deny (create): Non-admins cannot create media assets.
     * @deny (update): Non-admins cannot update media assets.
     * @deny (delete): Non-admins cannot delete media assets.
     * @principle Admin-only write access for media assets.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages access to user documents.
     * @path /users/{userId}
     * @allow (get): Only the user can read their own data.
     * @allow (create): Only the user can create their own document.
     * @allow (update): Only the user can update their own data.
     * @allow (delete): Only the user can delete their own account.
     * @deny (create): If the user tries to create a document with an ID that doesn't match their own.
     * @deny (update): If the user tries to modify another user's document.
     * @deny (delete): If the user tries to delete another user's document.
     * @principle Enforces user-ownership for user-specific data.
     */
    match /users/{userId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) && resource != null;
        allow delete: if isOwner(userId) && resource != null;
        allow list: if false;
    }
  }
}