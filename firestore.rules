/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset provides very strict control over data access.
 * The rules are designed to secure data based on the principle of least privilege,
 * limiting read and write access to only those users and roles that need it.
 * In this Prototyping stage, data validation is relaxed.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information.
 * - /contact/{contactId}: Stores contact information.
 *
 * Key Security Decisions:
 * - Contact Information is only editable by authenticated users.
 * - Project Information is only editable by authenticated users.
 *
 * Authorization Denormalization:
 * None. Assuming that all write operations require a user to be signed in.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows authenticated users to manage projects.
     * @path /projects/{projectId}
     * @allow (create) - Authenticated user can create a project.
     * @deny (create) - Unauthenticated user cannot create a project.
     * @allow (get, list) - Any user can read project information.
     * @allow (update, delete) - Authenticated user can update or delete a project.
     * @deny (update, delete) - Unauthenticated user cannot update or delete a project.
     * @principle Enforces authentication for writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Allows authenticated users to manage contact details.
     * @path /contact/{contactId}
     * @allow (create, update, delete) - Authenticated user can create, update, or delete contact information.
     * @deny (create, update, delete) - Unauthenticated user cannot create, update, or delete contact information.
     * @allow (get, list) - Any user can read contact information.
     * @principle Enforces authentication for writes.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // Helper function to determine if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}