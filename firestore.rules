/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model for administrative data (users, media)
 * and public read access for content data (projects, contact info, homepage settings).
 * Only authenticated 'admin' and 'superadmin' users can create or modify administrative data,
 * while read access to content is open to all.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project data, publicly readable.
 * - /contact/{contactId}: Stores contact information, publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings, publicly readable.
 * - /media/{mediaId}: Stores media asset metadata, only writable by admins.
 * - /users/{userId}: Stores user profiles, only accessible to the user themselves and superadmins.
 *
 * Key Security Decisions:
 * - Public read access to content collections enables wide data availability.
 * - Strict role-based access control protects administrative data.
 * - User listing is implicitly denied due to the lack of a general 'list' permission on the /users collection.
 *
 * Denormalization for Authorization:
 * This ruleset assumes that the `User` document contains a `role` field (either "admin" or "superadmin")
 * which determines authorization for administrative tasks such as media uploads.
 *
 * Structural Segregation:
 * The ruleset separates public content (projects, contact, homepage) from private user data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to project data and restricts writes to authenticated administrators.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @deny create: if !isAdmin();
     * @deny update: if !isAdmin();
     * @deny delete: if !isAdmin();
     * @principle Allows any user to read project data, but restricts modifications to administrators.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Grants public read access to contact information and restricts writes to authenticated administrators.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @deny create: if !isAdmin();
     * @deny update: if !isAdmin();
     * @deny delete: if !isAdmin();
     * @principle Allows any user to read contact information, but restricts modifications to administrators.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Grants public read access to homepage settings and restricts writes to authenticated administrators.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @deny create: if !isAdmin();
     * @deny update: if !isAdmin();
     * @deny delete: if !isAdmin();
     * @principle Allows any user to read homepage settings, but restricts modifications to administrators.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Restricts media asset creation, updates, and deletes to authenticated administrators.
     * @path /media/{mediaId}
     * @allow get, list: if isAdmin();
     * @allow create: if isAdmin();
     * @allow update: if isAdmin() && resource != null;
     * @allow delete: if isAdmin() && resource != null;
     * @deny get, list: if !isAdmin();
     * @deny create: if !isAdmin();
     * @deny update: if !isAdmin();
     * @deny delete: if !isAdmin();
     * @principle Enforces role-based access control to protect media assets from unauthorized modification.
     */
    match /media/{mediaId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Restricts user data access to the user themselves and superadmins.
     * @path /users/{userId}
     * @allow get: if isOwner(userId) || isSuperAdmin();
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if (isOwner(userId) && resource != null) || isSuperAdmin();
     * @allow delete: if isSuperAdmin() && resource != null;
     * @deny get: if !isOwner(userId) && !isSuperAdmin();
     * @deny create: if !isOwner(userId);
     * @deny update: if (!isOwner(userId) && !isSuperAdmin()) || resource == null;
     * @deny delete: if !isSuperAdmin() || resource == null;
     * @principle Enforces strict user-ownership for data privacy.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && resource != null) || isSuperAdmin();
      allow delete: if isSuperAdmin() && resource != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin');
    }

    function isSuperAdmin() {
       return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
  }
}