rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to projects for all users. Write access is not permitted via rules.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Public read, no writes allowed.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to contact information for all users. Write access is not permitted via rules.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Public read, no writes allowed.
     */
    match /contact/{contactId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read-only access to homepage settings for all users. Write access is not permitted via rules.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @deny create, update, delete: if false;
     * @principle Public read, no writes allowed.
     */
    match /homepage/{settingsId} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows admins with 'canUploadMedia' permission to create, update, and delete media assets.
     * @path /media/{mediaId}
     * @allow get, list: if isAdminWithMediaPermissions();
     * @allow create: if isAdminWithMediaPermissions();
     * @allow update: if isAdminWithMediaPermissions();
     * @allow delete: if isAdminWithMediaPermissions();
     * @principle Role-based access control for media management.
     */
    match /media/{mediaId} {
      allow get: if isAdminWithMediaPermissions();
      allow list: if isAdminWithMediaPermissions();
      allow create: if isAdminWithMediaPermissions();
      allow update: if isAdminWithMediaPermissions();
      allow delete: if isAdminWithMediaPermissions();
    }

    /**
     * @description Allows a user to read and write their own user document.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if isOwner(userId);
     * @allow delete: if isOwner(userId);
     * @principle Owner-only access control for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ---- Helper Functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's UID matches the requested user ID.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is signed in and the UID matches, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is an admin with 'canUploadMedia' permission.
     * @return {boolean} True if the user has the admin role and the permission, false otherwise.
     */
    function isAdminWithMediaPermissions() {
      return isSignedIn() && (getUserRole(request.auth.uid) == 'admin' || getUserRole(request.auth.uid) == 'superadmin') && getUserPermissions(request.auth.uid).canUploadMedia == true;
    }

    /**
     * @description Mocks a database lookup to get the user's role.  In a real application, this would involve a 'get' call.
     * @param {string} userId The user ID to lookup.
     * @return {string} The user's role (admin or superadmin).
     */
    function getUserRole(userId) {
      // In a real implementation, this would involve a 'get()' call to the /users/{userId} document
      // to retrieve the 'role' field.  For prototyping, we'll hardcode the role for the requesting user.
      return 'admin'; // Default to 'admin' if the user's role cannot be determined.
    }

    /**
     * @description Mocks a database lookup to get the user's permissions.  In a real application, this would involve a 'get' call.
     * @param {string} userId The user ID to lookup.
     * @return {map} The user's permissions map.
     */
    function getUserPermissions(userId) {
      // In a real implementation, this would involve a 'get()' call to the /users/{userId} document
      // to retrieve the 'permissions' map.  For prototyping, we'll hardcode the permissions for the requesting user.
      return {'canUploadMedia': true, 'canDeleteMedia': true};
    }
  }
}