/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * and public read access for projects, contact information, homepage settings, and media assets.
 * Only authenticated users can create, update, or delete data. Superadmin can create, update and delete user data.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information, publicly readable.
 * - /contact/{contactId}: Stores contact information, publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings, publicly readable.
 * - /media/{mediaId}: Stores media metadata, publicly readable.
 * - /users/{userId}: Stores user profiles, accessible only to the owner and superadmins.
 *
 * Key Security Decisions:
 * - Public read access is granted to the `projects`, `contact`, `homepage`, and `media` collections to allow all users to view content.
 * - User listing is explicitly denied.
 * - Write access to `projects`, `contact`, `homepage`, and `media` is restricted to authenticated users.
 * - Only a user that has a role 'superadmin' is allowed to create update and delete other users.
 *
 * Denormalization for Authorization:
 *  None. The current rules do not require denormalization.
 *
 * Structural Segregation:
 *  There is no segregation of private and public collections, since all projects, contact, homepage, and media are public and there is not a separate user private collection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, and restricts write access to authenticated users.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows any user to read project information, but only authenticated users to create, update, or delete.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants public read access to contact information, and restricts write access to authenticated users.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows any user to read contact information, but only authenticated users to create, update, or delete.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants public read access to homepage settings, and restricts write access to authenticated users.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows any user to read homepage settings, but only authenticated users to create, update, or delete.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants public read access to media assets, and restricts write access to authenticated users.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @deny get: if false;
     * @deny list: if false;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Allows any user to read media asset information, but only authenticated users to create, update, or delete.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Restricts access to user profiles to the owner and superadmins.
     * @path /users/{userId}
     * @allow get: if isOwner(userId) || isSuperAdmin();
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if (isOwner(userId) && resource != null) || isSuperAdmin();
     * @allow delete: if (isOwner(userId) && resource != null) || isSuperAdmin();
     * @deny get: if false;
     * @deny list: if true;
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Enforces document ownership and restricts listing to prevent unauthorized data access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) && resource != null) || isSuperAdmin();
      allow delete: if (isOwner(userId) && resource != null) || isSuperAdmin();
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has the 'superadmin' role.
     * @return {boolean} True if the user has the 'superadmin' role, false otherwise.
     */
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
  }
}