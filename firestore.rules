/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset is in prototyping mode, prioritizing a highly secure authorization model while relaxing data validation to allow for rapid iteration.  It enforces strict access control based on clearly defined roles or ownership, but does not perform detailed schema validation.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores individual project details. Publicly readable, but write access is restricted.
 * - /contact/{contactId}: Stores contact information. Publicly readable, but write access is restricted.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable, but write access is restricted.
 *
 * Key Security Decisions:
 * - Public Read Access:  The projects, contact info, and homepage settings are publicly readable.
 * - Owner-Only Writes: Writes (create, update, delete) are restricted and would require a custom claim to be granted.
 * - No User Listing: Listing all users is disallowed.
 *
 * Denormalization for Authorization:
 *  - Not applicable in this ruleset.
 *
 * Structural Segregation:
 *  - Not applicable in this ruleset.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to all projects. Write access is denied.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user can read project details.
     * @deny (create, update, delete) - No user can create, update, or delete projects without proper authorization.
     * @principle Grants public read access but restricts write access using custom claim.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to contact information. Write access is denied.
     * @path /contact/{contactId}
     * @allow (get, list) - Any user can read contact information.
     * @deny (create, update, delete) - No user can create, update, or delete contact information without proper authorization.
     * @principle Grants public read access but restricts write access using custom claim.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows read access to homepage settings. Write access is denied.
     * @path /homepage/{settingsId}
     * @allow (get, list) - Any user can read homepage settings.
     * @deny (create, update, delete) - No user can create, update, or delete homepage settings without proper authorization.
     * @principle Grants public read access but restricts write access using custom claim.
     */
    match /homepage/{settingsId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}