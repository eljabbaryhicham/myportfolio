/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to all data and restricts write access.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information.
 * - /contact/{contactId}: Stores contact information.
 * - /homepage/{settingsId}: Stores homepage settings.
 * - /media/{mediaId}: Stores metadata about media assets.
 *
 * Key Security Decisions:
 * - Public read access is granted to all collections to allow for easy data retrieval.
 * - All write access is denied.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, but denies all write operations.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No user can create, update, or delete project data.
     * @principle Public read, restricted write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to contact information, but denies all write operations.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact data.
     * @deny (create, update, delete): No user can create, update, or delete contact data.
     * @principle Public read, restricted write.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Grants public read access to homepage settings, but denies all write operations.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @deny (create, update, delete): No user can create, update, or delete homepage settings.
     * @principle Public read, restricted write.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
    
    /**
     * @description Grants public read access to media assets, but denies all write operations.
     * @path /media/{mediaId}
     * @allow (get, list): Any user can read media asset data.
     * @deny (create, update, delete): No user can create, update, or delete media asset data.
     * @principle Public read, restricted write.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}