/**
 * @file Firestore Security Rules
 * @version 2
 *
 * @description This ruleset enforces a role-based access control model for the portfolio application.
 * Only authenticated users with the 'admin' role can modify contact information and homepage settings.
 * Projects can be read by anyone, but creation, updates, and deletion are restricted to admins.
 *
 * @dataStructure
 * - /projects/{projectId}: Stores individual project data.
 * - /contact/{contactId}: Stores contact information (single document).
 * - /homepage/{settingsId}: Stores homepage settings (single document).
 *
 * @keySecurityDecisions
 * - Admin-only access for sensitive operations (contact info, homepage settings, project writes).
 * - Public read access for projects.
 * - No user-specific data or ownership is enforced, only an admin role.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read projects, but only admins can create, update, or delete them.
     * @path /projects/{projectId}
     * @allow (get, list) - Anyone can read project data.
     * @allow (create, update, delete) - Only users with the 'admin' role can modify project data.
     * @deny (create, update, delete) - Non-admin users cannot modify project data.
     * @principle Enforces role-based access control for project management.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Restricts access to contact information to users with the 'admin' role.
     * @path /contact/{contactId}
     * @allow (get, list, create, update, delete) - Only users with the 'admin' role can access or modify contact information.
     * @deny (get, list, create, update, delete) - Non-admin users cannot access or modify contact information.
     * @principle Enforces role-based access control for sensitive contact data.
     */
    match /contact/{contactId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    /**
     * @description Restricts access to homepage settings to users with the 'admin' role.
     * @path /homepage/{settingsId}
     * @allow (get, list, create, update, delete) - Only users with the 'admin' role can access or modify homepage settings.
     * @deny (get, list, create, update, delete) - Non-admin users cannot access or modify homepage settings.
     * @principle Enforces role-based access control for homepage configuration.
     */
    match /homepage/{settingsId} {
      allow get, list, create, update, delete: if isAdmin();
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user has the 'admin' role.
     * @return True if the user has the 'admin' role, false otherwise.
     * @example isAdmin() == true if request.auth.token.admin == true
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
  }
}