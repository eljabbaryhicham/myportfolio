/**
 * @description This ruleset enforces a role-based access control model for the portfolio application.
 *  It allows public read access to project, contact and homepage data.
 *  Admin users, identified by their 'admin' or 'superadmin' role in the `/users/{userId}` collection,
 *  can create, update, and delete media assets. User creation is self-creation;
 *  a user can create their own profile. Other user data is not directly accessible.
 * @dataStructure
 *  - /projects/{projectId}: Stores project information. Publicly readable.
 *  - /contact/{contactId}: Stores contact information. Publicly readable.
 *  - /homepage/{settingsId}: Stores homepage settings. Publicly readable.
 *  - /media/{mediaId}: Stores media asset metadata. Writable by admins only.
 *  - /users/{userId}: Stores user profiles. Only the user themselves can create their profile.
 * @keySecurityDecisions
 *  - Public read access to projects, contact info, and homepage settings.
 *  - Only authenticated admins can manage media assets.
 *  - Users can only create their own user document.
 *  - User listing is disallowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to project documents. Only admins can create, update, or delete.
     * @path /projects/{projectId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, admin-only write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to contact information. Only admins can create, update, or delete.
     * @path /contact/{contactId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, admin-only write.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to homepage settings. Only admins can create, update, or delete.
     * @path /homepage/{settingsId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Public read, admin-only write.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows authenticated admins to manage media assets.
     * @path /media/{mediaId}
     * @allow (create) User with 'admin' or 'superadmin' role can create a media asset.
     * @allow (update, delete) User with 'admin' or 'superadmin' role can update or delete an existing media asset.
     * @deny (create, update, delete) Unauthorized user attempts to create, update, or delete a media asset.
     * @deny (get, list) Public read is disallowed.
     * @principle Role-based access control.
     */
    match /media/{mediaId} {
      allow get, list: if false;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin() && resource != null;
      allow delete: if isSignedIn() && isAdmin() && resource != null;
    }

    /**
     * @description Allows a user to create their own profile.  No other access is permitted.
     * @path /users/{userId}
     * @allow (create) User can create their own profile if their auth UID matches the document ID.
     * @deny (get, list, update, delete) Unauthorized user attempts to read, list, update, or delete user data.
     * @principle User-ownership for profile creation.
     */
    match /users/{userId} {
      allow get, list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if false;
      allow delete: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "superadmin"];
    }
  }
}