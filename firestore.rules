/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes ease of iteration during prototyping. It focuses on secure authorization
 * while minimizing schema enforcement, allowing for rapid data model changes.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores individual project details.
 * - /contact/{contactId}: Stores contact information. There is only one contact document.
 *
 * Key Security Decisions:
 * - Authenticated users have full access to `projects` and `contact` documents.
 * - Detailed schema validation is skipped to allow rapid prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages read and write access to project documents. Any authenticated user can manage the projects.
     * @path /projects/{projectId}
     * @allow (create) User with any valid authentication can create a project.
     * @allow (update) User with any valid authentication can update a project.
     * @allow (delete) User with any valid authentication can delete a project.
     * @deny (create) Non-authenticated user cannot create a project.
     * @deny (update) Non-authenticated user cannot update a project.
     * @deny (delete) Non-authenticated user cannot delete a project.
     * @principle Authenticated users can manage projects.
     */
    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Manages read and write access to contact information. Any authenticated user can manage the contact information.
     * @path /contact/{contactId}
     * @allow (get) Any authenticated user can read the contact information.
     * @allow (list) Any authenticated user can list contact information (though there should only be one).
     * @allow (create) Any authenticated user can create contact information.
     * @allow (update) Any authenticated user can update contact information.
     * @allow (delete) Any authenticated user can delete contact information.
     * @deny (create) Non-authenticated user cannot create contact information.
     * @deny (update) Non-authenticated user cannot update contact information.
     * @deny (delete) Non-authenticated user cannot delete contact information.
     * @principle Authenticated users can manage contact information.
     */
    match /contact/{contactId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}