/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, primarily focused on protecting admin-level operations.
 * Regular users have no direct data access. The ruleset assumes an administrative backend will manage most data.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information. Publicly readable, but write access is restricted to authenticated admins.
 * - /contact/{contactId}: Stores contact information.  Write access restricted to authenticated admins.
 * - /homepage/{settingsId}: Stores homepage settings. Write access restricted to authenticated admins.
 * - /media/{mediaId}: Stores metadata about media assets. Write access restricted to authenticated admins.
 * - /users/{userId}: Stores admin user data. Only accessible to the user themselves.
 *
 * Key Security Decisions:
 * - No public write access: All write operations (create, update, delete) require authentication and admin privileges.
 * - User listing is disabled: There are no rules allowing `list` operations on the `/users` collection to prevent information disclosure.
 * - Ambiguous Relationships: Where the data model doesn't explicitly link a resource to an owner, the rules default to denying write access.
 * - Single contact and homepage setting documents: Assumes only one document exists for contact info and homepage settings (contactId and settingsId are fixed).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to projects for anyone, but restricts write access to authenticated admins.
     * @path /projects/{projectId}
     * @allow (get, list): if true
     * @allow (create, update, delete): if isSignedIn() && isAdmin()
     * @deny (create, update, delete): if !isSignedIn()
     * @principle Allows public read access while restricting writes to admins.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Restricts access to contact information to authenticated admins.
     * @path /contact/{contactId}
     * @allow (get, list): if isSignedIn() && isAdmin()
     * @allow (create, update, delete): if isSignedIn() && isAdmin()
     * @deny (get, list, create, update, delete): if !isSignedIn() || !isAdmin()
     * @principle Enforces admin-only access for contact information management.
     */
    match /contact/{contactId} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Restricts access to homepage settings to authenticated admins.
     * @path /homepage/{settingsId}
     * @allow (get, list): if isSignedIn() && isAdmin()
     * @allow (create, update, delete): if isSignedIn() && isAdmin()
     * @deny (get, list, create, update, delete): if !isSignedIn() || !isAdmin()
     * @principle Enforces admin-only access for homepage settings management.
     */
    match /homepage/{settingsId} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Restricts access to media assets to authenticated admins.
     * @path /media/{mediaId}
     * @allow (get, list): if isSignedIn() && isAdmin()
     * @allow (create, update, delete): if isSignedIn() && isAdmin()
     * @deny (get, list, create, update, delete): if !isSignedIn() || !isAdmin()
     * @principle Enforces admin-only access for media asset management.
     */
    match /media/{mediaId} {
      allow get, list: if isSignedIn() && isAdmin();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Restricts access to user documents to the user themselves.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny list: if true;
     * @principle Enforces user-ownership for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isAdmin() {
    return isSignedIn() && (getUserRole() == 'admin' || getUserRole() == 'superadmin');
  }

  function getUserRole() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
  }
}