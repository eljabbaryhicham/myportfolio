/**
 * @description This ruleset enforces a role-based access control model for the portfolio application.
 *  It allows admins to manage projects, contact information, homepage settings, and media assets.
 *  Regular users can only read projects and contact information.
 *  User documents are private and only accessible to the owner.
 * @dataStructure
 *  /projects/{projectId}: Stores project information.
 *  /contact/{contactId}: Stores contact page information.
 *  /homepage/{settingsId}: Stores homepage settings.
 *  /media/{mediaId}: Stores metadata for uploaded Cloudinary assets.
 *  /users/{userId}: Stores administrator user data.
 * @keySecurityDecisions
 *  - Only authenticated users can access the admin functionalities.
 *  - Media uploads and deletes are restricted to admin users with appropriate permissions.
 *  - User listing is explicitly disallowed.
 *  - Superadmins can manage all users, including granting or revoking admin privileges.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows admins to manage projects.
     * @path /projects/{projectId}
     * @allow (create) User with 'admin' role can create a project.
     * @deny (create) User without 'admin' role cannot create a project.
     * @allow (get, list) All users can read projects.
     * @deny (update, delete) Non-admin users cannot update or delete projects.
     * @principle Enforces role-based access control for project management.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage contact information.
     * @path /contact/{contactId}
     * @allow (create) User with 'admin' role can create contact information.
     * @deny (create) User without 'admin' role cannot create contact information.
     * @allow (get, list) All users can read contact information.
     * @deny (update, delete) Non-admin users cannot update or delete contact information.
     * @principle Enforces role-based access control for contact information management.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins to manage homepage settings.
     * @path /homepage/{settingsId}
     * @allow (create) User with 'admin' role can create homepage settings.
     * @deny (create) User without 'admin' role cannot create homepage settings.
     * @allow (get, list) All users can read homepage settings.
     * @deny (update, delete) Non-admin users cannot update or delete homepage settings.
     * @principle Enforces role-based access control for homepage settings management.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Allows admins with 'canUploadMedia' permission to create media assets.
     *  Allows admins with 'canDeleteMedia' permission to delete media assets.
     * @path /media/{mediaId}
     * @allow (create) User with 'admin' role and 'canUploadMedia' permission can create a media asset.
     * @deny (create) User without 'admin' role or 'canUploadMedia' permission cannot create a media asset.
     * @allow (get, list) All users can read media assets.
     * @deny (update) Non-admin users cannot update media assets.
     * @allow (delete) User with 'admin' role and 'canDeleteMedia' permission can delete a media asset.
     * @deny (delete) User without 'admin' role or 'canDeleteMedia' permission cannot delete a media asset.
     * @principle Enforces role-based access control for media asset management.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isAdmin() && hasPermission('canUploadMedia');
      allow update: if false;
      allow delete: if isAdmin() && hasPermission('canDeleteMedia');
    }

    /**
     * @description Allows a user to read, update, and delete their own user document.  Only superadmins can create users.
     * @path /users/{userId}
     * @allow (create) User can create their own document if the userId matches their auth.uid.
     * @allow (get, list) User can read their own document.
     * @allow (update, delete) User can update and delete their own document.
     * @deny (create) User cannot create a document with a userId that does not match their auth.uid.
     * @deny (get, list) User cannot read another user's document.
     * @deny (update, delete) User cannot update or delete another user's document.
     * @principle Enforces document ownership for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId && isSuperAdmin();
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
        return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function hasPermission(permission) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true;
    }
  }
}