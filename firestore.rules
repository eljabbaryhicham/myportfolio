/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with special considerations for media uploads.
 *
 * Data Structure:
 * - /projects/{projectId}: Publicly readable project data.
 * - /contact/{contactId}: Publicly readable contact information.
 * - /homepage/{settingsId}: Publicly readable homepage settings.
 * - /media/{mediaId}:  Metadata about uploaded media assets; write access is restricted to admins.
 * - /users/{userId}:  User profiles, accessible only by the user themselves.
 *
 * Key Security Decisions:
 * - Public read access to projects, contact info and homepage settings.
 * - Strict owner-only access to user profiles.
 * - Media uploads and deletions are restricted to authenticated admins with specific permissions.
 *
 * Denormalization for Authorization:
 * - The 'User' entity includes a 'role' field and 'permissions' object that determines authorization for media uploads and deletions.
 *
 * Structural Segregation:
 * - Public and private data is separated into different collections. Public data (projects, contact info, homepage settings) resides in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to projects and restricts write access to authenticated admins.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, admin-only write.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read access to contact information and restricts write access to authenticated admins.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, admin-only write.
     */
    match /contact/{contactId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows read access to homepage settings and restricts write access to authenticated admins.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, admin-only write.
     */
    match /homepage/{settingsId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts write access to media assets to authenticated admins with 'canUploadMedia' permission.
     * @path /media/{mediaId}
     * @allow get, list: if isAdminWithMediaPermissions();
     * @allow create: if isAdminWithMediaPermissions();
     * @allow update: if false;
     * @allow delete: if isAdminWithMediaPermissions() && resource != null;
     * @principle Role-based access control for media management.
     */
    match /media/{mediaId} {
      allow get: if isAdminWithMediaPermissions();
      allow list: if isAdminWithMediaPermissions();
      allow create: if isAdminWithMediaPermissions();
      allow update: if false;
      allow delete: if isAdminWithMediaPermissions() && resource != null;
    }

    /**
     * @description Restricts access to user profiles to the owning user.
     * @path /users/{userId}
     * @allow get, list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Owner-only access to user data.
     */
    match /users/{userId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isExistingOwner(userId);
        allow delete: if isExistingOwner(userId);
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the resource.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the owner of the resource and the resource exists.
     * @param {string} userId The user ID to check against.
     * @return {bool} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }

    /**
     * @description Checks if the user is an admin with media upload/delete permissions.
     * @return {bool} True if the user is an admin, false otherwise.
     */
    function isAdminWithMediaPermissions() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
             && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canUploadMedia == true
             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canDeleteMedia == true);
    }
  }
}