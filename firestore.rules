/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes simplicity and security. It implements a public-read, owner-write model
 * for the 'projects' collection and a public-read, protected-write model for the 'contact' collection, allowing
 * anyone to view the data while restricting modifications.
 *
 * Data Structure:
 * The database contains two top-level collections: 'projects' and 'contact'.
 * - /projects/{projectId}: Stores individual project details.  Intended for public display.
 * - /contact/{contactId}: Stores contact information. Intended for public display.
 *
 * Key Security Decisions:
 * - Listing of projects and reading contact data is completely open to all users.
 * - Only authenticated users can create, update, or delete projects.
 * - Only authenticated users can create, update, or delete contact data.
 * - Data validation is relaxed in this prototyping phase to allow for rapid schema iteration.
 *
 * Denormalization for Authorization:
 *  - The `Project` entity requires an `ownerId` field for secure write operations.
 *    Since this field is not currently defined in the `Project` entity, rules for create, update, and delete operations are not implemented.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read project data, but restricts creation, updates, and deletion to authenticated users.
     * @path /databases/{database}/documents/projects/{projectId}
     * @allow (get, list): Anyone can read project data.
     * @deny (create, update, delete): Only authenticated users can modify project data.
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /projects/{projectId} {
      allow get, list: if true;

      // CRITICAL: Cannot implement owner-only writes. The 'Project' entity is missing an 'ownerId' or 'authorId' field.
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows anyone to read contact information, but restricts creation, updates, and deletion to authenticated users.
     * @path /databases/{database}/documents/contact/{contactId}
     * @allow (get, list): Anyone can read contact information.
     * @deny (create, update, delete): Only authenticated users can modify contact information.
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}