rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read projects, but only authenticated admins can create, update, or delete them.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn() && isAdmin();
     * @allow update: if isSignedIn() && isAdmin();
     * @allow delete: if isSignedIn() && isAdmin();
     * @deny create: if !isSignedIn() || !isAdmin();
     * @deny update: if !isSignedIn() || !isAdmin();
     * @deny delete: if !isSignedIn() || !isAdmin();
     * @principle Public read, admin-only writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows anyone to read contact information, but only authenticated admins can create, update, or delete it.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn() && isAdmin();
     * @allow update: if isSignedIn() && isAdmin();
     * @allow delete: if isSignedIn() && isAdmin();
     * @deny create: if !isSignedIn() || !isAdmin();
     * @deny update: if !isSignedIn() || !isAdmin();
     * @deny delete: if !isSignedIn() || !isAdmin();
     * @principle Public read, admin-only writes.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows anyone to read homepage settings, but only authenticated admins can create, update, or delete them.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn() && isAdmin();
     * @allow update: if isSignedIn() && isAdmin();
     * @allow delete: if isSignedIn() && isAdmin();
     * @deny create: if !isSignedIn() || !isAdmin();
     * @deny update: if !isSignedIn() || !isAdmin();
     * @deny delete: if !isSignedIn() || !isAdmin();
     * @principle Public read, admin-only writes.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }

    /**
     * @description Allows anyone to read media assets, but only authenticated admins with the `canUploadMedia` permission can create, update, or delete them.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn() && isAdmin() && canUploadMedia();
     * @allow update: if isSignedIn() && isAdmin() && canUploadMedia();
     * @allow delete: if isSignedIn() && isAdmin() && canDeleteMedia();
     * @deny create: if !isSignedIn() || !isAdmin() || !canUploadMedia();
     * @deny update: if !isSignedIn() || !isAdmin() || !canUploadMedia();
     * @deny delete: if !isSignedIn() || !isAdmin() || !canDeleteMedia();
     * @principle Public read, admin-only writes with granular permissions.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isAdmin() && canUploadMedia();
      allow update: if isSignedIn() && isAdmin() && canUploadMedia();
      allow delete: if isSignedIn() && isAdmin() && canDeleteMedia();
    }

    /**
     * @description Only the user can read, update, or delete their own user document.  Admins cannot list all users.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
     * @allow update: if isOwner(userId) && request.resource.data.uid == request.auth.uid;
     * @allow delete: if isOwner(userId);
     * @deny create: if !isOwner(userId) || request.resource.data.uid != request.auth.uid;
     * @deny update: if !isOwner(userId) || resource.data.uid != resource.data.uid;
     * @deny delete: if !isOwner(userId);
     * @principle Enforces document ownership for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    // ---- Helper functions ----

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function canUploadMedia() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canUploadMedia == true;
    }

    function canDeleteMedia() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canDeleteMedia == true;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}