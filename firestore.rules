/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on distinct collections for projects, contact information, and homepage settings.
 * Public read access is granted for specific collections, while write access is restricted to authenticated users.
 *
 * Data Structure:
 * - `/projects/{projectId}`: Stores project information.
 * - `/contact/{contactId}`: Stores contact information.
 * - `/homepage/{settingsId}`: Stores homepage settings.
 *
 * Key Security Decisions:
 * - Public read access for all documents in `/projects`, `/contact`, and `/homepage`.
 * - Authenticated user-only write access for all documents.
 *
 * Denormalization for Authorization:
 * Not applicable in this scenario as authorization is based on authentication status.
 *
 * Structural Segregation:
 * Not applicable in this scenario.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to project documents.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project details.
     * @allow (create, update, delete): Only authenticated users can modify projects.
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read, authenticated write.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to contact information documents.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact information.
     * @allow (create, update, delete): Only authenticated users can modify contact information.
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read, authenticated write.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Manages access to homepage settings documents.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @allow (create, update, delete): Only authenticated users can modify homepage settings.
     * @deny create: if false;
     * @deny update: if false;
     * @deny delete: if false;
     * @principle Public read, authenticated write.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}