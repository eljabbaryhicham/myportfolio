/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, owner-based access control model where applicable,
 * combined with explicit denials for restricted operations. It assumes a prototyping
 * environment with flexible data shapes but strict authorization.
 *
 * Data Structure:
 * - /projects/{projectId}: Publicly readable projects, writable only by authenticated admins.
 * - /contact/{contactId}: Single document, writable only by authenticated admins.
 * - /homepage/{settingsId}: Single document, writable only by authenticated admins.
 * - /media/{mediaId}: Publicly readable media assets, writable only by authenticated admins.
 * - /users/{userId}: User profiles, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - Projects are publicly readable but only modifiable by authenticated users. The rules do not enforce any user roles or permissions.
 * - User listing is implicitly denied.
 * - Write access is generally restricted to authenticated users with matching UIDs or admin roles (where explicitly defined).
 * - In the absence of explicit role definitions or ownership fields, write operations are denied by default to ensure a secure posture.
 * - All destructive operations (update, delete) require the document to exist.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, but restricts write access to authenticated users.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @principle Public read, authenticated write.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Restricts read and write access to the contact information to authenticated users.
     * @path /contact/{contactId}
     * @allow get: if isSignedIn();
     * @allow list: if false;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @principle Authenticated access only.
     */
    match /contact/{contactId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Restricts read and write access to homepage settings to authenticated users.
     * @path /homepage/{settingsId}
     * @allow get: if isSignedIn();
     * @allow list: if false;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @principle Authenticated access only.
     */
    match /homepage/{settingsId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Grants public read access to media assets, but restricts write access to authenticated users.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn() && resource != null;
     * @allow delete: if isSignedIn() && resource != null;
     * @principle Public read, authenticated write.
     */
    match /media/{mediaId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Restricts access to user documents to the owning user.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces user ownership.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}