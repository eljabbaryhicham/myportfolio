/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model, with an "admin" role granting elevated privileges,
 * while generally restricting access to non-admins. User documents are only accessible by the user themselves or an administrator.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information; publicly readable, but only editable by admins.
 * - /contact/{contactId}: Stores contact information; publicly readable, but only editable by admins.
 * - /homepage/{settingsId}: Stores homepage settings; publicly readable, but only editable by admins.
 * - /media/{mediaId}: Stores media asset metadata; only admins can create, read, update, or delete.
 * - /users/{userId}: Stores user data; only the user themselves or an admin can read/write.
 *
 * Key Security Decisions:
 * - Media creation is limited to admins.
 * - Listing of the /media collection is not permitted to prevent unauthorized enumeration of assets.
 * - Users can only read and write their own user document, unless the request comes from an admin.
 *
 * Denormalization for Authorization:
 * The User document includes a 'role' field. This field is checked in the rules to determine administrative privileges.
 * The User document includes granular permissions field, to controle media uploading and deleting.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

   /**
     * @description Checks if the user is the owner of the existing document.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for the /projects collection.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @allow (create, update, delete): Only admins can modify project data.
     * @deny (create, update, delete): Non-admins cannot modify project data.
     * @principle Allows public read access but restricts modifications to admins.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /contact collection.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact information.
     * @allow (create, update, delete): Only admins can modify contact information.
     * @deny (create, update, delete): Non-admins cannot modify contact information.
     * @principle Allows public read access but restricts modifications to admins.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /homepage collection.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @allow (create, update, delete): Only admins can modify homepage settings.
     * @deny (create, update, delete): Non-admins cannot modify homepage settings.
     * @principle Allows public read access but restricts modifications to admins.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Rules for the /media collection.
     * @path /media/{mediaId}
     * @allow (get): Only admins can get media metadata.
     * @allow (create): Only admins can create media metadata.
     * @allow (update, delete): Only admins can update or delete media metadata.
     * @deny (list): Listing media is not allowed.
     * @principle Enforces strict admin-only access for media management.
     */
    match /media/{mediaId} {
      allow get: if isAdmin();
      allow list: if false;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Rules for the /users collection.
     * @path /users/{userId}
     * @allow (get): Only the user or an admin can read user data.
     * @allow (create): Only the user can create their own user document.
     * @allow (update, delete): Only the user or an admin can update or delete user data.
     * @deny (create): Creating a user document with a mismatched user ID is not allowed.
     * @principle Enforces document ownership and admin overrides for user management.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if false;
      allow create: if isOwner(userId) ;
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }
  }
}