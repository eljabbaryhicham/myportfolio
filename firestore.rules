/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user data and public read access for other data.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information. Publicly readable.
 * - /contact/{contactId}: Stores contact information. Publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable.
 * - /media/{mediaId}: Stores media asset metadata. Publicly readable.
 * - /users/{userId}: Stores user-specific data. Only accessible to the owner.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect user privacy.
 * - Public read access is granted to projects, contact info, homepage settings, and media assets to facilitate content delivery.
 * - User documents are strictly controlled by their respective owners.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to project data, but restricts write access to the owner.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No one can create, update, or delete project data directly through the client.
     * @principle Public read, no client writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to contact information, but restricts write access.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact information.
     * @deny (create, update, delete): No one can create, update, or delete contact information directly through the client.
     * @principle Public read, no client writes.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to homepage settings, but restricts write access.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @deny (create, update, delete): No one can create, update, or delete homepage settings directly through the client.
     * @principle Public read, no client writes.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

   /**
     * @description Allows public read access to media assets, but restricts write access.
     * @path /media/{mediaId}
     * @allow (get, list): Any user can read media assets.
     * @deny (create, update, delete): No one can create, update, or delete media assets directly through the client.
     * @principle Public read, no client writes.
     */
    match /media/{mediaId} {
        allow get, list: if true;
        allow create, update, delete: if false;
    }

    /**
     * @description Manages user-specific data, ensuring only the authenticated user can access their own data.
     * @path /users/{userId}
     * @allow (create): Only the authenticated user can create their own document if the userId matches their auth UID.
     * @allow (get, update, delete): Only the authenticated user can get, update, or delete their own document.
     * @deny (list): Listing users is not allowed.
     * @deny (create): Creating a user is disallowed if the userId does not match the auth UID.
     * @deny (update, delete): Updating/deleting a user is disallowed if the user does not exist.
     * @principle Enforces strict document ownership based on user ID.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }

  // --- Helper Functions ---
  /**
   * @description Checks if the request is authenticated.
   * @return {boolean} True if the user is signed in, false otherwise.
   */
  function isSignedIn() {
    return request.auth != null;
  }

  /**
   * @description Checks if the authenticated user ID matches the provided user ID.
   * @param {string} userId The user ID to compare against the authenticated user's UID.
   * @return {boolean} True if the user is the owner, false otherwise.
   */
  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  /**
   * @description Combines ownership and existence checks.
   * @param {string} userId The user ID of the supposed owner.
   * @return {boolean} True if the user owns the document and the document exists.
   */
  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}