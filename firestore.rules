/**
 * @file Firestore Security Rules
 * @core-philosophy This ruleset secures the 'projects' collection, allowing public read access but requiring authentication for write access. It assumes administrative access is handled client-side, as the provided data model does not define user-specific roles or ownership.
 * @data-structure The data is stored in a flat `/projects/{projectId}` collection.
 * @key-security-decisions Write access is protected via `isSignedIn()`, but no further validation is performed. This is for prototyping only, and a production system would need to check admin roles or perform other authorization. List access is public.
 * @denormalization Authorization is not denormalized because it's assumed that administrative access is handled on the client-side. In a more complex scenario with user-based permissions, fields like 'ownerId' or a 'members' map would be added to each project.
 * @structural-segregation All projects are in a single collection, indicating no need to segregate public vs. private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read access to all projects, but requires authentication for creating, updating, and deleting projects.
     * @path /databases/{database}/documents/projects/{projectId}
     * @allow (get, list) - Any user can read project data.
     * @allow (create) - Authenticated user can create a project.
     * @allow (update) - Authenticated user can update a project.
     * @allow (delete) - Authenticated user can delete a project.
     * @deny (create) - Unauthenticated user cannot create a project.
     * @deny (update) - Unauthenticated user cannot update a project.
     * @deny (delete) - Unauthenticated user cannot delete a project.
     * @principle Allows public read access with authenticated-only writes.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // Define helper functions
    function isSignedIn() {
      return request.auth != null;
    }
  }
}