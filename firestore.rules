rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access for projects, but restricts modifications to admins/superadmins.
     * @path /projects/{projectId}
     * @allow (get, list) if true
     * @allow (create, update, delete) if request.auth != null && isAdmin()
     * @deny (create, update, delete) if request.auth == null
     * @principle Allows public read access while enforcing admin-only writes.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    /**
     * @description Restricts access to contact information to admins/superadmins only.
     * @path /contact/{contactId}
     * @allow (create, update, delete) if request.auth != null && isAdmin()
     * @allow (get, list) if request.auth != null && isAdmin()
     * @deny (create, update, delete) if request.auth == null || !isAdmin()
     * @deny (get, list) if request.auth == null || !isAdmin()
     * @principle Enforces admin-only access to sensitive contact information.
     */
    match /contact/{contactId} {
      allow get: if request.auth != null && isAdmin();
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    /**
     * @description Restricts access to homepage settings to admins/superadmins only.
     * @path /homepage/{settingsId}
     * @allow (create, update, delete) if request.auth != null && isAdmin()
     * @allow (get, list) if request.auth != null && isAdmin()
     * @deny (create, update, delete) if request.auth == null || !isAdmin()
     * @deny (get, list) if request.auth == null || !isAdmin()
     * @principle Enforces admin-only access to homepage settings.
     */
    match /homepage/{settingsId} {
      allow get: if request.auth != null && isAdmin();
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    /**
     * @description Restricts access to media assets to admins/superadmins only.
     * @path /media/{mediaId}
     * @allow (create, update, delete) if request.auth != null && isAdmin()
     * @allow (get, list) if request.auth != null && isAdmin()
     * @deny (create, update, delete) if request.auth == null || !isAdmin()
     * @deny (get, list) if request.auth == null || !isAdmin()
     * @principle Enforces admin-only access to media assets.
     */
    match /media/{mediaId} {
      allow get: if request.auth != null && isAdmin();
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null && isAdmin();
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    /**
     * @description Restricts access to user data to the user themselves and superadmins.
     * @path /users/{userId}
     * @allow create: if request.auth.uid == userId;
     * @allow get: if request.auth.uid == userId || isSuperAdmin();
     * @allow list: if false;
     * @allow update: if (request.auth.uid == userId || isSuperAdmin()) && resource != null;
     * @allow delete: if isSuperAdmin() && resource != null;
     * @deny list: if true;
     * @principle Enforces user-only access to their own data, with superadmin override.
     */
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin();
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }


    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
        return request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin';
    }

    function isSuperAdmin() {
        return request.auth.token.role == 'superadmin';
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}