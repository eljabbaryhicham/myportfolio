/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, restricting access to only authenticated users where appropriate and
 * defaulting to read-only access for public data. It enforces strict ownership for user-specific data.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores individual project details. Publicly readable, but only authorized users can modify.
 * - /contact/{contactId}: Stores contact information. Publicly readable, but only authorized users can modify.
 * - /homepage/{settingsId}: Stores settings for the homepage. Publicly readable, but only authorized users can modify.
 *
 * Key Security Decisions:
 * - Public Read Access: The rules allow public read access (`get`, `list`) to the `projects`, `contact`, and `homepage` collections,
 *   making the portfolio content visible to everyone.
 * - Owner-Only Writes:  Write access (`create`, `update`, `delete`) to `projects`, `contact`, and `homepage` is restricted. The rules currently lack a mechanism to authorize these writes.  Adding an admin role or user-based authentication is required.
 *
 * Denormalization for Authorization:
 *  - No denormalization is used in the current rules.  If write access were to be restricted to specific users,
 *    then fields like `ownerId` or `authorId` would need to be added to the entities, or roles would need to be defined.
 *
 * Structural Segregation:
 *  - No structural segregation is used.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to project data and restricts write access.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @deny (create, update, delete): No one can currently modify project data.  Requires authentication and authorization logic.
     * @principle Allows public reads, restricts writes until proper authorization is implemented.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to contact information and restricts write access.
     * @path /contact/{contactId}
     * @allow (get, list): Any user can read contact information.
     * @deny (create, update, delete): No one can currently modify contact information.  Requires authentication and authorization logic.
     * @principle Allows public reads, restricts writes until proper authorization is implemented.
     */
    match /contact/{contactId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to homepage settings and restricts write access.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any user can read homepage settings.
     * @deny (create, update, delete): No one can currently modify homepage settings.  Requires authentication and authorization logic.
     * @principle Allows public reads, restricts writes until proper authorization is implemented.
     */
    match /homepage/{settingsId} {
      allow get: if true;
      allow list: if true;
      allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}