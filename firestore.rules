/**
 * @file Firestore Security Rules
 * @description This ruleset provides admin access to all collections, effectively bypassing all authorization checks.
 *
 * Core Philosophy:
 * This ruleset is configured for rapid prototyping, granting full access to all data for authenticated users. This should ONLY be used in development and MUST be replaced with a more restrictive ruleset before deployment.
 *
 * Data Structure:
 * The Firestore database contains collections for 'projects', 'contact', 'homepage', and 'media', each with individual documents identified by unique IDs.
 *
 * Key Security Decisions:
 * - All authenticated users are treated as administrators and have full read/write access to all data.
 * - No data validation is performed, allowing any data to be written to any document.
 *
 * WARNING: This ruleset is INSECURE and should NEVER be used in a production environment.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants full access to the 'projects' collection for all authenticated users.
     * @path /projects/{projectId}
     * @allow (create, update, delete, get, list) - Any authenticated user can create, update, delete, get, and list projects.
     * @deny (none) - No requests are denied.
     * @principle Allows any authenticated user to perform any operation on project documents.
     */
    match /projects/{projectId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full access to the 'contact' collection for all authenticated users.
     * @path /contact/{contactId}
     * @allow (create, update, delete, get, list) - Any authenticated user can create, update, delete, get, and list contact information.
     * @deny (none) - No requests are denied.
     * @principle Allows any authenticated user to perform any operation on contact information documents.
     */
    match /contact/{contactId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full access to the 'homepage' collection for all authenticated users.
     * @path /homepage/{settingsId}
     * @allow (create, update, delete, get, list) - Any authenticated user can create, update, delete, get, and list homepage settings.
     * @deny (none) - No requests are denied.
     * @principle Allows any authenticated user to perform any operation on homepage settings documents.
     */
    match /homepage/{settingsId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Grants full access to the 'media' collection for all authenticated users.
     * @path /media/{mediaId}
     * @allow (create, update, delete, get, list) - Any authenticated user can create, update, delete, get, and list media assets.
     * @deny (none) - No requests are denied.
     * @principle Allows any authenticated user to perform any operation on media asset documents.
     */
    match /media/{mediaId} {
      allow read, write: if isSignedIn();
    }

    // Helper function to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
  }
}