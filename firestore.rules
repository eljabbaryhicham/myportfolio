rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     * @param None
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user's UID matches the provided userId.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is a superadmin.
     * @return {boolean} True if the user is a superadmin, false otherwise.
     */
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    /**
     * @description Checks if the user is an admin.
     * @return {boolean} True if the user is an admin, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    /**
     * @description Checks if the user is an admin and has a specific permission.
     * @param {string} permission The permission to check for (e.g., 'canUploadMedia').
     * @return {boolean} True if the user is an admin and has the permission, false otherwise.
     */
    function hasPermission(permission) {
      return isAdmin() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions[permission] == true;
    }

    /**
     * @description Checks if the user is the owner and the resource exists.
     * @param {string} userId The user ID to compare against.
     * @return {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
        return isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId));
    }

    /**
     * @description Rules for the /projects/{projectId} collection.
     * @path /projects/{projectId}
     * @allow (get, list): Any signed-in user can read project information.
     * @allow (create, update, delete): Only superadmins or admins can modify project information.
     * @deny (create): A non-admin user attempts to create a project.
     * @principle Enforces role-based access control for project data.
     */
    match /projects/{projectId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    /**
     * @description Rules for the /contact/{contactId} collection.
     * @path /contact/{contactId}
     * @allow (get, list): Any signed-in user can read contact information.
     * @allow (create, update, delete): Only superadmins or admins can modify contact information.
     * @deny (create): A non-admin user attempts to create contact information.
     * @principle Enforces role-based access control for contact data.
     */
    match /contact/{contactId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    /**
     * @description Rules for the /homepage/{settingsId} collection.
     * @path /homepage/{settingsId}
     * @allow (get, list): Any signed-in user can read homepage settings.
     * @allow (create, update, delete): Only superadmins or admins can modify homepage settings.
     * @deny (create): A non-admin user attempts to create homepage settings.
     * @principle Enforces role-based access control for homepage settings data.
     */
    match /homepage/{settingsId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    /**
     * @description Rules for the /media/{mediaId} collection.
     * @path /media/{mediaId}
     * @allow (get, list): Any signed-in user can read media asset metadata.
     * @allow create: Only admins with 'canUploadMedia' permission or superadmins can upload media.
     * @allow update: if false;
     * @allow delete: Only admins with 'canDeleteMedia' permission or superadmins can delete media.
     * @deny create: A non-admin user attempts to upload media.
     * @deny delete: A non-admin user attempts to delete media.
     * @principle Enforces role-based access control for media assets.
     */
    match /media/{mediaId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin() || hasPermission('canUploadMedia');
      allow update: if false;
      allow delete: if isSuperAdmin() || hasPermission('canDeleteMedia');
    }

    /**
     * @description Rules for the /users/{userId} collection.
     * @path /users/{userId}
     * @allow get: Only the owner (the user themselves) or a superadmin can read the user's data.
     * @allow list: if false; // Listing users is not allowed
     * @allow create: if isOwner(userId) && request.resource.data.uid == userId; // Only the user can create their own profile.
     * @allow update, delete: if isSuperAdmin(); // Only superadmins can update or delete user profiles.
     * @deny create: A user attempts to create a profile for another user.
     * @deny update: A non-superadmin attempts to update another user's profile.
     * @deny delete: A non-superadmin attempts to delete another user's profile.
     * @principle Enforces user ownership for profile reads and superadmin control for modifications.
     */
    match /users/{userId} {
        allow get: if isOwner(userId) || isSuperAdmin();
        allow list: if false;
        allow create: if isOwner(userId) && request.auth.uid == userId;
        allow update, delete: if isSuperAdmin();
    }
  }
}