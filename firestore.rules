/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model, primarily for administrative users.
 * All data is stored in top-level collections (e.g., /projects/{projectId}).
 * Key Security Decisions:
 *   - Only authenticated admins can create, update, and delete media assets.
 *   - Read access to projects, contact info, and homepage settings is public.
 *   - Users collection: Only the user themselves can read and write their own document.
 *
 * To simplify authorization and avoid costly `get()` calls, the `User` document includes a `role` field (e.g., 'admin', 'superadmin').
 * The existence of a `role` field in the user document is sufficient for authorization, and no further role validation is performed.
 * Media assets are secured based on the admin role. Only admins should create update and delete.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to projects, but restricts write access to authenticated users with admin roles.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user can read projects.
     * @allow (create, update, delete) - Only authenticated admin can create, update, or delete projects.
     * @deny (create, update, delete) - Non-authenticated users cannot create, update, or delete projects.
     * @principle Public read, role-based writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Allows public read access to contact information, but restricts write access to authenticated users with admin roles.
     * @path /contact/{contactId}
     * @allow (get, list) - Any user can read contact information.
     * @allow (create, update, delete) - Only authenticated admin can create, update, or delete contact information.
     * @deny (create, update, delete) - Non-authenticated users cannot create, update, or delete contact information.
     * @principle Public read, role-based writes.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Allows public read access to homepage settings, but restricts write access to authenticated users with admin roles.
     * @path /homepage/{settingsId}
     * @allow (get, list) - Any user can read homepage settings.
     * @allow (create, update, delete) - Only authenticated admin can create, update, or delete homepage settings.
     * @deny (create, update, delete) - Non-authenticated users cannot create, update, or delete homepage settings.
     * @principle Public read, role-based writes.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Restricts access to media assets. Only authenticated admins can create, read, update, and delete.
     * @path /media/{mediaId}
     * @allow (get, list) - Any user can read media.
     * @allow (create, update, delete) - Only authenticated admins can create, update, or delete media.
     * @deny (create, update, delete) - Non-authenticated users cannot create, update, or delete media.
     * @principle Role-based access control.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Restricts access to user documents. Only the authenticated user can read and write their own document.
     * @path /users/{userId}
     * @allow (get) - The user can read their own document.
     * @allow (create) - The user can create their own document (self-registration).
     * @allow (update, delete) - The user can update/delete their own document.
     * @deny (get) - A user cannot read another user's document.
     * @deny (create) - A user cannot create a document with another user's ID.
     * @deny (update, delete) - A user cannot update/delete another user's document.
     * @principle Owner-only access.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) ;
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
      allow list: if false;
    }

    /**
     * @description Checks if the user is signed in.
     * @return {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the document, based on the provided userId.
     * @param {string} userId - The user ID to compare against the request's authentication UID.
     * @return {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user has the admin role.
     * @return {boolean} True if the user has the admin role, false otherwise.
     */
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
  }
}