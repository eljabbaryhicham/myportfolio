
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Helper function to check for super admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'eljabbaryhicham@example.com';
    }

    // Helper function to check if the user has a specific permission
    function hasPermission(permission) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.data.permissions[permission] == true;
    }

    // PUBLIC-READABLE COLLECTIONS
    // Projects, contact, and homepage settings can be read by anyone, but only written by admins.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contact/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepage/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ADMIN-ONLY COLLECTIONS
    // Media assets can be read by any admin, created if they have permission, and deleted if they have permission
    match /media/{mediaId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && hasPermission('canUploadMedia');
      allow update: if isAdmin() && hasPermission('canUploadMedia');
      allow delete: if isAdmin() && hasPermission('canDeleteMedia');
    }

    // User documents can be read by any admin.
    // Only a super admin can create, update, or delete other users.
    // Admins cannot delete themselves.
    match /users/{userId} {
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin() && request.auth.uid != userId;
    }
  }
}
