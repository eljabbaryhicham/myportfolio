/**
 * @file Firebase Security Rules for Liquid Folio Projects
 * @core_philosophy This ruleset allows public read access to project data, while restricting write access to authorized administrators.
 * @data_structure All project data is stored in a flat `/projects/{projectId}` collection.
 * @key_security_decisions Write permissions are not granted to the client. It's assumed that authorization is handled on the client-side via admin credentials. If specific users were allowed to edit certain projects, a `members` map could be added to each project document to include that authorization information.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, while restricting write access.
     * @path /projects/{projectId}
     * @allow (get, list) Public read access is allowed for all users.
     * @deny (create, update, delete) Write access is denied for all users.
     * @principle Public read, admin-only write.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}