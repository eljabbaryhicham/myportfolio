/**
 * @file Firestore Security Rules
 * @core_philosophy This ruleset prioritizes security by enforcing strict access control.
 * All write operations are restricted to authenticated users. Read operations are generally public.
 * @data_structure The database consists of three top-level collections: 'projects', 'contact', and 'homepage'.
 * @key_security_decisions All write operations require authentication. Data validation is minimal.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to the 'projects' collection.
     * @path /projects/{projectId}
     * @allow (read): Any user can read project data.
     * @allow (create): Only authenticated users can create projects. The `id` field is validated for consistency.
     * @allow (update): Only authenticated users can update existing projects.
     * @allow (delete): Only authenticated users can delete existing projects.
     * @deny (create): An unauthenticated user attempts to create a project.
     * @deny (update): An unauthenticated user attempts to update a project.
     * @deny (delete): An unauthenticated user attempts to delete a project.
     * @principle Authenticated users can create, update, and delete any project.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'contact' collection.
     * @path /contact/{contactId}
     * @allow (read): Any user can read contact information.
     * @allow (create): Only authenticated users can create contact information. The `id` field is validated for consistency.
     * @allow (update): Only authenticated users can update existing contact information.
     * @allow (delete): Only authenticated users can delete existing contact information.
     * @deny (create): An unauthenticated user attempts to create contact information.
     * @deny (update): An unauthenticated user attempts to update contact information.
     * @deny (delete): An unauthenticated user attempts to delete contact information.
     * @principle Authenticated users can create, update, and delete any contact info.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    /**
     * @description Controls access to the 'homepage' collection.
     * @path /homepage/{settingsId}
     * @allow (read): Any user can read homepage settings.
     * @allow (create): Only authenticated users can create homepage settings. The `id` field is validated for consistency.
     * @allow (update): Only authenticated users can update existing homepage settings.
     * @allow (delete): Only authenticated users can delete existing homepage settings.
     * @deny (create): An unauthenticated user attempts to create homepage settings.
     * @deny (update): An unauthenticated user attempts to update homepage settings.
     * @deny (delete): An unauthenticated user attempts to delete homepage settings.
     * @principle Authenticated users can create, update, and delete homepage settings.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // Helper function to check if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}