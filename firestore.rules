/**
 * @fileoverview Firestore Security Rules for Liquid Folio Projects.
 *
 * Core Philosophy:
 * This ruleset allows public read access to all projects while restricting write access (create, update, delete) to authenticated users.
 * It assumes that authorization is handled separately, such as through an admin panel, as the app requirements don't define user-specific roles.
 *
 * Data Structure:
 * All project data is stored in a flat `/projects` collection.  Each project document contains fields like title, description, imageUrl, etc.
 *
 * Key Security Decisions:
 * - Read access (get, list) is public.
 * - Write access (create, update, delete) requires authentication.
 * - No validation is performed on the data itself, focusing solely on authentication for write operations to allow for flexible data changes.
 *
 * Denormalization for Authorization:
 * The current design doesn't require denormalization, as write access is solely based on authentication, not on document content or user roles.
 * If finer-grained control were required (e.g., allowing specific users to edit certain projects), a `members` map would be added to each project document to store user roles for that project.
 *
 * Structural Segregation:
 * All data is stored in a single, publicly readable collection, which aligns with the admin-centric editing use case.  If the application grows to include draft projects or user-specific project visibility, consider separating into a public `projects` collection and a private `users/{userId}/projects` subcollection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects and restricts write access to authenticated users.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project data.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete projects.
     * @deny (create, update, delete): Unauthenticated users cannot create, update, or delete projects.
     * @principle Allows public read access while restricting writes to authenticated users (admins).
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    // --- Helper Functions ---

    /**
     * @description Checks if the user is signed in.
     * @return True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}