/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * and public read access for content like projects, contact info, homepage settings, and media.
 * Only authenticated administrators can modify user profiles, while all other
 * content is publicly readable but only writable by authenticated users.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information. Publicly readable.
 * - /contact/{contactId}: Stores contact information. Publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable.
 * - /media/{mediaId}: Stores media asset metadata. Publicly readable.
 * - /users/{userId}: Stores user profile data, where userId matches the Firebase Auth UID.
 *
 * Key Security Decisions:
 * - Public read access to projects, contact info, homepage settings, and media.
 * - User profiles are only accessible and modifiable by authenticated admins.
 * - No listing of users is allowed.
 * - Flexible data shapes are allowed during this prototyping phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to project data and restricts write access.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to contact information and restricts write access.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to homepage settings and restricts write access.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Grants public read access to media assets and restricts write access.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to authenticated users.
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to user documents to the owner only.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if isOwner(userId);
     * @allow delete: if isOwner(userId);
     * @deny get: if !isOwner(userId);
     * @deny create: if !isOwner(userId);
     * @deny update: if !isOwner(userId);
     * @deny delete: if !isOwner(userId);
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
        return request.auth.uid == userId;
    }
  }
}