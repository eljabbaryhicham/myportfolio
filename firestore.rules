/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset enforces a role-based access control model with a special 'superadmin' role that bypasses all other restrictions.
 * Regular 'admin' users can only manage Projects and Media Assets. Users can only manage their own user documents.
 * Public read access is enabled for Projects and ContactInfo.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information.
 * - /contact/{contactId}: Stores contact page information.
 * - /homepage/{settingsId}: Stores homepage settings.
 * - /media/{mediaId}: Stores metadata for uploaded Cloudinary assets.
 * - /users/{userId}: Stores administrator user data.
 *
 * Key Security Decisions:
 * - Superadmins have full access to all data, bypassing all other rules.
 * - Regular admins can create, update, and delete projects.
 * - Public read access to projects is allowed.
 * - No public listing of media assets is allowed. Only admins can manage media.
 * - Users can only manage their own user documents.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is a superadmin.
     */
    function isSuperAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    /**
     * @description Checks if the user is an admin.
     */
    function isAdmin() {
      return isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || isSuperAdmin());
    }

    /**
     * @description Checks if the user is the owner of the document.
     * @param {string} userId The user ID to check against.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the user is the existing owner of the document.
     * @param {string} userId The user ID to check against.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Grants full access to superadmins.
     */
    match /{document=**} {
        allow read, write: if isSuperAdmin();
    }

    /**
     * @description Manages projects.
     * @path /projects/{projectId}
     * @allow (create) User with admin role can create a project.
     * @deny (create) User without admin role cannot create a project.
     * @allow (get) Any user can read project data.
     * @deny (create) User without admin role cannot create a project.
     * @principle Allows admins to manage projects.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages contact information.
     * @path /contact/{contactId}
     * @allow (get) Any user can read contact information.
     * @deny (create) Only superadmin can create
     * @principle Allows public read access to contact information.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() && resource != null;
      allow delete: if isSuperAdmin() && resource != null;
    }

    /**
     * @description Manages homepage settings.
     * @path /homepage/{settingsId}
     * @allow (create) User with admin role can create homepage settings.
     * @deny (create) User without admin role cannot create homepage settings.
     * @principle Allows admins to manage homepage settings.
     */
    match /homepage/{settingsId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages media assets.
     * @path /media/{mediaId}
     * @allow (create) User with admin role can create media assets.
     * @deny (create) User without admin role cannot create media assets.
     * @principle Allows admins to manage media assets.
     */
    match /media/{mediaId} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() && resource != null;
      allow delete: if isAdmin() && resource != null;
    }

    /**
     * @description Manages user data.
     * @path /users/{userId}
     * @allow (create) User can create their own user document.
     * @deny (create) User cannot create another user's document.
     * @principle Enforces user-ownership for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}