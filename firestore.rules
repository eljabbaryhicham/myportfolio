/**
 * @file Firestore Security Rules
 * @description This ruleset defines access control for the portfolio app's Firestore database.
 *
 * Core Philosophy:
 * The security model prioritizes data protection while allowing flexible data access patterns for rapid prototyping.
 * - Public read access for certain collections (e.g., projects) to showcase portfolio content.
 * - Owner-only write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information. Publicly readable, owner-only writable.
 * - /contact/{contactId}: Stores contact information. Publicly readable, owner-only writable.
 * - /homepage/{settingsId}: Stores homepage settings. Publicly readable, owner-only writable.
 *
 * Key Security Decisions:
 * - Public read access is granted to the 'projects', 'contact', and 'homepage' collections for showcasing the portfolio.
 * - Write access is restricted to owners, but the ruleset currently lacks a mechanism to identify the owner for these collections. This needs to be addressed by adding an 'ownerId' or similar field to the documents.
 * - List operations are generally allowed, assuming data is intended for public display.
 *
 * Denormalization for Authorization:
 * - The ruleset relies on the presence of an 'ownerId' field in the documents to enforce ownership for write operations. If this field is missing, the ruleset will not be able to properly restrict write access.
 *
 * Structural Segregation:
 * - The app uses top-level collections for 'projects', 'contact', and 'homepage', which are intended for public display. This is a good practice for separating public and private data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects and restricts write access to the owner.
     * @path /projects/{projectId}
     * @allow (get, list) Anyone can read the list of projects or get a project.
     * @deny (create, update, delete) Only the owner can modify or delete a project. The owner is not yet defined for this prototyping phase.
     * @principle Enforces document ownership for writes and allows public reads.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to contact information and restricts write access to the owner.
     * @path /contact/{contactId}
     * @allow (get, list) Anyone can read the contact information.
     * @deny (create, update, delete) Only the owner can modify the contact information. The owner is not yet defined for this prototyping phase.
     * @principle Enforces document ownership for writes and allows public reads.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Grants public read access to homepage settings and restricts write access to the owner.
     * @path /homepage/{settingsId}
     * @allow (get, list) Anyone can read the homepage settings.
     * @deny (create, update, delete) Only the owner can modify the homepage settings. The owner is not yet defined for this prototyping phase.
     * @principle Enforces document ownership for writes and allows public reads.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}