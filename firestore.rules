
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return request.auth.token.email == 'eljabbaryhicham@example.com';
    }

    function canUploadMedia() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canUploadMedia == true;
    }

    function canDeleteMedia() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canDeleteMedia == true;
    }

    // Public collections: anyone can read, only admins can write.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /contact/{contactId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /homepage/{settingsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Media collection: All admins can read, create is controlled by permission, delete by permission.
    match /media/{mediaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && canUploadMedia();
      allow delete: if request.auth != null && canDeleteMedia();
    }

    // Users collection:
    // Super admin can read/write everything.
    // A regular user can read their own document.
    match /users/{userId} {
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      allow list, write: if isSuperAdmin();
    }
  }
}
