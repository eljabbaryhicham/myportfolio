/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset prioritizes security by default, enforcing strict access control based on authentication and authorization.
 * It follows a principle of least privilege, granting only the necessary permissions to each user based on their role.
 * Public read access is granted only for specific collections explicitly designed for public consumption.
 *
 * Data Structure:
 * - /projects/{projectId}: Stores project information; publicly readable.
 * - /contact/{contactId}: Stores contact information; publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings; publicly readable.
 * - /media/{mediaId}: Stores media asset metadata; publicly readable.
 * - /users/{userId}: Stores user-specific data; only accessible by the user themselves.
 *
 * Key Security Decisions:
 * - Public Read Access for Content: The `projects`, `contact`, `homepage`, and `media` collections are publicly readable to allow for easy content display.
 * - User-Scoped Data: All user data is stored under `/users/{userId}`, ensuring that users can only access their own information.
 * - No User Listing: Listing all users is explicitly denied to prevent information leakage.
 *
 * Denormalization for Authorization:
 * No denormalization is needed for the existing rules because the rules rely on the `request.auth.uid` and the path parameters for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows read-only access to project data. Only the project owner can create, update, or delete projects.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes (requires schema update).
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Secure create, update, delete access based on admin role
    }

    /**
     * @description Allows read-only access to contact information. Only the contact info owner can create, update, or delete contact info.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes (requires schema update).
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Secure create, update, delete access based on admin role
    }

    /**
     * @description Allows read-only access to homepage settings. Only the homepage settings owner can create, update, or delete homepage settings.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes (requires schema update).
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Secure create, update, delete access based on admin role
    }

    /**
     * @description Allows read-only access to media assets. Only the media owner can create, update, or delete media assets.
     * @path /media/{mediaId}
     * @allow get, list: if true;
     * @allow create: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow update: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @allow delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
     * @principle Public read, owner-only writes (requires schema update).
     */
    match /media/{mediaId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Secure create, update, delete access based on admin role
    }

    /**
     * @description Allows a user to read, write, update and delete their own user document.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    // ---- Helper functions ----
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}