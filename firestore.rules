/**
 * @fileoverview Firestore Security Rules for the portfolio application.
 *
 * Core Philosophy:
 * This ruleset provides public read access to project and contact information,
 * while restricting write access to prevent unauthorized modifications. This is
 * suitable for a portfolio where content is primarily managed through the
 * Firebase console or a dedicated admin interface (not covered by these rules).
 *
 * Data Structure:
 * - /projects/{projectId}: Stores individual project details.
 * - /contact/{contactId}: Stores contact information. Only a single contact document is expected.
 *
 * Key Security Decisions:
 * - Public read access is granted for both projects and contact information to allow anyone to view the portfolio.
 * - Write access (create, update, delete) is completely denied for all users.  Content updates are assumed to be managed
 *   through a separate, secured admin interface or directly via the Firebase console.
 * - No user-specific data is stored, so user-based access control is not required.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to project data, but restricts all write access.
     * @path /projects/{projectId}
     * @allow (get, list) Any user can read project data.
     * @deny (create, update, delete) No user can create, update, or delete project data.
     * @principle Grants public read access while restricting writes for content managed externally.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows public read access to contact information, but restricts all write access.
     * @path /contact/{contactId}
     * @allow (get, list) Any user can read contact information.
     * @deny (create, update, delete) No user can create, update, or delete contact information.
     * @principle Grants public read access while restricting writes for content managed externally.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}