/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a role-based access control model with special considerations for media uploads.
 *
 * Data Structure:
 * - /projects/{projectId}: Publicly readable project data.
 * - /contact/{contactId}: Publicly readable contact information.
 * - /homepage/{settingsId}: Publicly readable homepage settings.
 * - /media/{mediaId}: Media asset metadata, write-protected and accessible only to authenticated admin users.
 * - /users/{userId}: User profiles, accessible only to the user themselves.
 *
 * Key Security Decisions:
 * - Public read access to projects, contact info, and homepage settings is permitted.
 * - Media uploads are restricted to authenticated users only.  The existence of the 'admin' role is not validated.
 * - User listing is disallowed.
 * - The rules are written to allow rapid prototyping and do not enforce strict schema validation.
 * - Documents are only updated or deleted if they exist.
 *
 * Denormalization for Authorization:
 * - The rules assume that any authorization data (e.g., user roles, permissions) needed is denormalized directly
 *   onto the documents being secured. This avoids costly `get()` calls in the rules.
 *
 * Structural Segregation:
 * - Private user data is stored under the `/users/{userId}` path, separate from public data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to project data and restricts write access.
     * @path /projects/{projectId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, restricted writes.
     */
    match /projects/{projectId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to contact information and restricts write access.
     * @path /contact/{contactId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, restricted writes.
     */
    match /contact/{contactId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Grants public read access to homepage settings and restricts write access.
     * @path /homepage/{settingsId}
     * @allow get, list: if true;
     * @allow create: if false;
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Public read, restricted writes.
     */
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts media asset creation, updates, and deletion to authenticated users.
     * @path /media/{mediaId}
     * @allow get, list: if false;
     * @allow create: if isSignedIn();
     * @allow update: if false;
     * @allow delete: if false;
     * @principle Authenticated users only.
     */
    match /media/{mediaId} {
      allow get, list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows each user to read and write their own user document.
     * @path /users/{userId}
     * @allow get: if isOwner(userId);
     * @allow list: if false;
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @principle User-owned data, self-creation allowed.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /** Helper functions */

    // Returns true if the user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }

    // Returns true if the request is made by the owner of the resource.
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Returns true if the request is made by the owner of the resource and the resource exists.
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}