/**
 * @description This ruleset enforces a role-based access control model for the portfolio application.
 * It provides granular access based on user roles (admin, superadmin) and individual permissions (e.g., canUploadMedia, canDeleteMedia).
 * Additionally, it ensures data consistency by validating relationships between user UIDs and document IDs.
 *
 * @dataStructure
 * - /projects/{projectId}: Stores project information, publicly readable.
 * - /contact/{contactId}: Stores contact information, publicly readable.
 * - /homepage/{settingsId}: Stores homepage settings, publicly readable.
 * - /media/{mediaId}: Stores metadata for media assets, write access controlled by admin roles.
 * - /users/{userId}: Stores user data, only accessible to the user themselves and superadmins.
 *
 * @keySecurityDecisions
 * - Public read access for projects, contact info, and homepage settings.
 * - Media asset creation and management restricted to authenticated users with 'admin' or 'superadmin' roles and the 'canUploadMedia' permission.
 * - User data is strictly private, accessible only to the user themselves or superadmins.
 * - No user listing is allowed.
 *
 * @denormalizationForAuthorization
 * - User roles and permissions are stored directly within the /users/{userId} document to simplify authorization checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read project information. Writes are disallowed.
     * @path /projects/{projectId}
     * @allow (get, list) - Any user can read project information.
     * @deny (create, update, delete) - No one can write project information through direct Firestore access.
     * @principle Public read access for projects.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read contact information. Writes are disallowed.
     * @path /contact/{contactId}
     * @allow (get, list) - Any user can read contact information.
     * @deny (create, update, delete) - No one can write contact information through direct Firestore access.
     * @principle Public read access for contact information.
     */
    match /contact/{contactId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read homepage settings. Writes are disallowed.
     * @path /homepage/{settingsId}
     * @allow (get, list) - Any user can read homepage settings.
     * @deny (create, update, delete) - No one can write homepage settings through direct Firestore access.
     * @principle Public read access for homepage settings.
     */
    match /homepage/{settingsId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows admins with 'canUploadMedia' permission to create media assets. Read access is public. Update and delete are disallowed.
     * @path /media/{mediaId}
     * @allow (get, list) - Any user can read media asset information.
     * @allow (create) - Authenticated admins with 'canUploadMedia' can create media assets. Example: User with role 'admin', canUploadMedia=true
     * @deny (create) - Non-authenticated users or admins without 'canUploadMedia' cannot create. Example: Anonymous user or user with role 'viewer'.
     * @deny (update, delete) - No one can update or delete media assets.
     * @principle Role-based access control for media asset creation.
     */
    match /media/{mediaId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAdminWithMediaUploadPermission();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows a user to read and write their own user document. Superadmins can read any user document.
     * @path /users/{userId}
     * @allow (get) - The user can read their own document, or a superadmin can read any user document.
     * @allow (create) - A user can create their own document if the userId matches their auth UID.
     * @allow (update) - The user can update their own document, or a superadmin can update any user document.
     * @allow (delete) - The user can delete their own document, or a superadmin can delete any user document.
     * @deny (get, create, update, delete) - Any other user attempting to access another user's document.
     * @principle User-ownership and superadmin access for user data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if false;
      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isExistingOwner(userId) || isSuperAdmin();
      allow delete: if isExistingOwner(userId) || isSuperAdmin();
    }

    /**
     * @description Helper function to determine if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Helper function to determine if the user is the owner of the document based on the provided userId.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Helper function to determine if the user is the owner of the document and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Helper function to determine if the user has the 'admin' role with 'canUploadMedia' permission.
     */
    function isAdminWithMediaUploadPermission() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.canUploadMedia == true;
    }

    /**
     * @description Helper function to determine if the user has the 'superadmin' role.
     */
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }
  }
}