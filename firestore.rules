rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Superadmin (fixed email) has universal read/write access.
    // NOTE: this email MUST stay in sync with `src/lib/constants.ts` SUPERADMIN_EMAIL.
    // If you change it here, change it there too (and vice versa).
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'eljabbaryhicham@mellivision.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Look up the caller's own user document (if any).
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Whether the caller's user doc grants a given permission.
    function hasPerm(perm) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myUser().permissions[perm] == true;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (myUser().role == 'admin' || myUser().role == 'superadmin');
    }

    // SUPERADMIN OVERRIDE: applied first, master key.
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }

    // Projects: publicly readable; writable by admins with canEditProjects.
    match /projects/{projectId} {
      allow get, list: if true;
      allow write: if hasPerm('canEditProjects');
    }

    // Contact: publicly readable; writable by admins with canEditContact.
    match /contact/{contactId} {
      allow get, list: if true;
      allow write: if hasPerm('canEditContact');
    }

    // Homepage: publicly readable; writable by admins with canEditHome.
    match /homepage/{settingsId} {
      allow get, list: if true;
      allow write: if hasPerm('canEditHome');
    }

    // About: publicly readable; writable by admins with canEditAbout.
    match /about/{docId} {
      allow get, list: if true;
      allow write: if hasPerm('canEditAbout');
    }

    // Clients (About carousel): publicly readable; writable by admins with canEditAbout.
    match /clients/{clientId} {
      allow get, list: if true;
      allow write: if hasPerm('canEditAbout');
    }

    // Vercel Blob metadata: admin-only.
    match /vercel_blobs/{docId} {
      allow get, list: if isAdmin();
      allow create: if hasPerm('canUploadMedia');
      allow delete: if hasPerm('canDeleteMedia');
      allow update: if false;
    }

    // Media metadata: admin-only, gated by explicit perms.
    match /media/{mediaId} {
      allow list, get: if isAdmin();
      allow create: if hasPerm('canUploadMedia');
      allow delete: if hasPerm('canDeleteMedia');
      allow update: if false;
    }

    // Users:
    match /users/{userId} {
      // Users can read their own doc; admins can read any user doc.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Only admins can list users (admin management page).
      allow list: if isAdmin();
      // A user may create their own doc ONLY as an unprivileged account. Setting
      // an elevated role or permissions is reserved for existing admins/superadmin.
      allow create: if isSuperAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == 'user'
            && request.resource.data.permissions == null);
      // Update policy:
      //   - superadmin: any update
      //   - self (anyone, including non-admin): may edit their own doc BUT
      //     role and permissions must not change (prevents self-elevation)
      //   - non-superadmin admin (canEditHome) editing OTHER users: may only
      //     change `username` and `email`. They CANNOT change role or
      //     permissions, which closes the chain where a bad admin promotes
      //     another user to superadmin. Only the existing superadmin can
      //     grant or revoke elevated access.
      //   - non-admin editing other users: denied
      allow update: if isSuperAdmin()
        || (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.permissions == resource.data.permissions)
        || (hasPerm('canEditHome')
            && request.auth.uid != userId
            && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['username', 'email']));
      // Prevent non-superadmins from deleting user documents.
      allow delete: if isSuperAdmin();
    }
  }
}
