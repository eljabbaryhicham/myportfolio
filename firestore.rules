
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    //
    // Get a user's role from their user document.
    //
    function getRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    //
    // Get a user's permissions from their user document.
    //
    function getPermissions(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.permissions;
    }

    //
    // Check if a user is an admin or superadmin.
    //
    function isSuperAdmin(uid) {
      return getRole(uid) == 'superadmin';
    }

    //
    // Check if the currently authenticated user is an admin
    //
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }
    
    match /contact/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /homepage/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      // Admins can be read by any other admin (for the admin management panel).
      allow list: if isAdmin();
      // Only the superadmin can create, update, or delete other user records.
      // A user can read their own record.
      allow read, create, update, delete: if isSuperAdmin(request.auth.uid) || request.auth.uid == userId;
    }

    match /media/{mediaId} {
      // Any authenticated admin can read the media list and individual documents.
      allow read: if isAdmin();
      
      // An admin can create a media document if they have the canUploadMedia permission.
      allow create: if getPermissions(request.auth.uid).canUploadMedia == true;
      
      // An admin can delete a media document if they have the canDeleteMedia permission.
      allow delete: if getPermissions(request.auth.uid).canDeleteMedia == true;
    }
  }
}
