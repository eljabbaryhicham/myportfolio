/**
 * @file Firestore Security Rules for Liquid Folio Projects
 *
 * @description This ruleset allows public read access to all projects, while restricting write access to authenticated users.
 * All project data is stored in the top-level `/projects` collection.
 *
 * @dataStructure All project documents are stored under the `/projects/{projectId}` path.  Project documents contain project details such as title, description, and image URLs.
 *
 * @keySecurityDecisions
 *   - Public Read Access:  The `get` and `list` operations are open to the public.
 *   - Authenticated Write Access: Only authenticated users can create, update, or delete projects. This assumes the existence of an external mechanism (e.g., admin panel authentication) for managing project content.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to projects, while restricting write access to authenticated users.
     * @path /projects/{projectId}
     * @allow (get, list): Any user can read project details.
     * @allow (create, update, delete): Only authenticated users can create, update, or delete projects.
     * @deny (create, update, delete): Unauthenticated users cannot modify project data.
     * @principle Allows public read access while restricting write access to authenticated users for managing projects.
     */
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

    //------------------- Helper functions -------------------

    /**
     * @description Checks if the user is signed in.
     * @return {bool} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}