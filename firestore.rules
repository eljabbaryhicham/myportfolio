rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read access to see the portfolio projects
    match /projects/{projectId} {
      allow read: if true;
    }

    // Allow public read access for the contact page
    match /contact/details {
        allow read: if true;
    }

    // Allow ONLY authenticated users to write to the projects and contact collections.
    // This secures your admin panel functionality.
    match /projects/{projectId} {
      allow write: if request.auth != null;
    }

    match /contact/details {
      allow write: if request.auth != null;
    }
  }
}
