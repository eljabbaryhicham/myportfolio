# =============================================================================
# Example environment file. Copy to .env.local and fill in your secrets.
# .env.local (and all .env* files) is gitignored — NEVER commit a populated file.
# =============================================================================

# -----------------------------------------------------------------------------
# Email (Resend) — required for the contact form
# Get yours from https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key

# -----------------------------------------------------------------------------
# Google AI (Gemini) — used by Genkit flows
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------------------------------------------------------
# Firebase service account (server-side Admin SDK)
# Prefer ONE of the following:
#   1. FIREBASE_SERVICE_ACCOUNT_KEY: full JSON service-account as a single
#      stringified env var (newlines in private_key may be escaped as \\n).
#   2. FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY:
#      split credentials.
#   3. Rely on Application Default Credentials when running on Firebase
#      App Hosting / Cloud Run (no env vars needed).
#
# In production, prefer App Hosting-managed credentials (option 3).
# For local dev, use option 1 (single var) so rotation is one env change.
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-sa@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# Cloudinary — primary media provider
# Cloud name + upload preset are PUBLIC (NEXT_PUBLIC_) so the browser can
# upload directly. API key + secret are server-only and only used by the
# delete/cleanup flow.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Secondary Cloudinary library (optional)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME_2=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET_2=
CLOUDINARY_CLOUD_NAME_2=
CLOUDINARY_API_KEY_2=
CLOUDINARY_API_SECRET_2=

# -----------------------------------------------------------------------------
# Vercel Blob (optional) — alternative media provider
# Create a read/write token at https://vercel.com/dashboard/stores
# Required for the Vercel Blob upload flow.
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN=vercel_blob_xxx

# -----------------------------------------------------------------------------
# Google Search Console verification (HTML tag method)
# Get the value from https://search.google.com/search-console → Add property
# → URL prefix → HTML tag. Paste only the `content="..."` value here.
# Optional — site will still work without it, but you won't be able to verify
# ownership in Search Console without redeploying after adding the value.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_code

# -----------------------------------------------------------------------------
# Self-registration invite code (optional, server-side only)
# The /register page checks this code server-side. If unset, the endpoint
# fails closed (refuses all self-registrations). The superadmin-only
# "New Admin" dialog is unaffected and still works.
# Generate with: `openssl rand -base64 32` and rotate to revoke outstanding codes.
# -----------------------------------------------------------------------------
# REGISTER_INVITE_CODE=your_long_random_string_here
